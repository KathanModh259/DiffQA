# ==========================================
# DiffQA Configuration & Model Provider Keys
# ==========================================

# Choose which provider to use:
# Options: "meta", "fireworks", "baseten", "modal", "ollama", "mock"
# Default is "mock" for local zero-cost testing, switch to "meta" or partner when you have keys!
DIFFQA_PROVIDER=mock

# 1. Meta Model API (https://dev.meta.ai/docs). META_API_KEY is accepted as an alias.
MODEL_API_KEY=
META_API_BASE=https://api.meta.ai/v1

# 2. Hackathon Partner: Fireworks AI ($25 free credits)
# Claim at fireworks.ai -> API Keys. With DIFFQA_PROVIDER=fireworks set all three model
# variables below to: accounts/fireworks/models/muse-spark-open
FIREWORKS_API_KEY=

# 3. Hackathon Partner: Baseten ($100 free credits)
# Claim at baseten.co -> API Keys
BASETEN_API_KEY=

# 4. Hackathon Partner: Modal ($100 free credits)
# Claim at modal.com
MODAL_API_KEY=
# Your deployed Modal app's OpenAI-compatible base URL (without /chat/completions)
MODAL_API_BASE=

# Model IDs. Defaults are Meta Model API IDs. Fireworks/Baseten/Modal host Muse Spark Open
# under their own IDs: copy them from the provider's console when you switch provider.
DIFFQA_CODE_MODEL=muse-spark-1.3
DIFFQA_AGENT_MODEL=muse-spark-1.3
DIFFQA_JUDGE_MODEL=muse-spark-1.3

# Browser Automation Settings
HEADLESS=true
ACTION_TIMEOUT_MS=10000
NAVIGATION_TIMEOUT_MS=30000

